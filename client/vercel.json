{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "collarone.vercel.app" }],
      "destination": "https://collarone.app/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/automations-run",
      "schedule": "30 9 * * *"
    }
  ]
}
